    "NSCameraUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird benötigt, damit dein Kind den Barcode eines Artikels scannen und bezahlen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is needed so your child can scan an item’s barcode to pay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is needed so your child can scan an item’s barcode to pay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita la cámara para que tu hijo pueda escanear el código de barras de un artículo y pagar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お子さまが商品のバーコードを読み取って支払うために、カメラが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀가 물품 바코드를 찍어서 결제하려면 카메라가 필요해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孩子扫描商品条形码进行支付时需要使用相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孩子掃描商品條碼進行支付時需要使用相機。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wird verwendet, um ein Elternteil zu bestätigen und die Aktionen zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to confirm a parent when unlocking Actions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to confirm a parent when unlocking Actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa Face ID para confirmar que eres un adulto al desbloquear las acciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護者の確認（アクションのロック解除）のためにFace IDを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부모 확인(액션 잠금 해제)을 위해 Face ID를 사용해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容ID来确认家长身份（解锁“操作”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用Face ID來確認家長身份（解鎖「操作」）。"
          }
        }
      }
    }
  },
  "version" : "1.0"
