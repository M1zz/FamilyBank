    "NSCameraUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát je potřeba, aby dítě mohlo naskenovat čárový kód položky a zaplatit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet er nødvendigt, for at barnet kan scanne en vares stregkode og betale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird benötigt, damit dein Kind den Barcode eines Artikels scannen und bezahlen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα χρειάζεται για να σκανάρει το παιδί τον γραμμωτό κώδικα ενός προϊόντος και να πληρώσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is needed so your child can scan an item’s barcode to pay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is needed so your child can scan an item’s barcode to pay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita la cámara para que tu hijo pueda escanear el código de barras de un artículo y pagar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraa tarvitaan, jotta lapsi voi skannata tuotteen viivakoodin ja maksaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo est nécessaire pour que ton enfant scanne le code-barres d’un article et paie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera diperlukan agar anak bisa memindai barcode barang untuk membayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera serve per far scansionare a tuo figlio il codice a barre di un articolo e pagare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お子さまが商品のバーコードを読み取って支払うために、カメラが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀가 물품 바코드를 찍어서 결제하려면 카메라가 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet trengs for at barnet kan skanne strekkoden på en vare og betale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera é necessária para seu filho escanear o código de barras de um item e pagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера нужна, чтобы ребёнок мог отсканировать штрихкод товара и оплатить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้กล้องเพื่อให้ลูกสแกนบาร์โค้ดสินค้าแล้วจ่ายเงิน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần camera để con quét mã vạch món hàng và thanh toán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孩子扫描商品条形码进行支付时需要使用相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孩子掃描商品條碼進行支付時需要使用相機。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID slouží k potvrzení rodiče při odemknutí akcí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID bruges til at bekræfte en forælder, når handlinger låses op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wird verwendet, um ein Elternteil zu bestätigen und die Aktionen zu entsperren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Face ID χρησιμοποιείται για την επιβεβαίωση γονέα κατά το ξεκλείδωμα των ενεργειών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to confirm a parent when unlocking Actions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to confirm a parent when unlocking Actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa Face ID para confirmar que eres un adulto al desbloquear las acciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID:tä käytetään vanhemman vahvistamiseen toimintojen lukitusta avattaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID sert à confirmer qu’un parent est présent pour déverrouiller les actions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID digunakan untuk mengonfirmasi orang tua saat membuka kunci Aksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID viene usato per confermare un genitore e sbloccare le azioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護者の確認（アクションのロック解除）のためにFace IDを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부모 확인(액션 잠금 해제)을 위해 Face ID를 사용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID brukes til å bekrefte en forelder når handlinger låses opp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID é usado para confirmar um responsável e desbloquear as ações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID используется для подтверждения родителя при разблокировке действий."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ Face ID เพื่อยืนยันว่าเป็นพ่อแม่ตอนปลดล็อกการดำเนินการ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Face ID để xác nhận bố mẹ khi mở khóa Thao tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容ID来确认家长身份（解锁“操作”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用Face ID來確認家長身份（解鎖「操作」）。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
