        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お子さまが商品のバーコードを読み取って支払うために、カメラが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀가 물품 바코드를 찍어서 결제하려면 카메라가 필요해요."
