          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 ราคาเปลี่ยนวันละครั้ง ซื้อตอนถูกขายตอนแพงได้กำไร กลับกันขาดทุน!"
          }
