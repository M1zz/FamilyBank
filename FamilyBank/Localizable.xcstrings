    "💡 돈을 그냥 두면 힘이 줄어요. 저축(이자)이나 투자로 지켜 보세요!" : {
      "comment" : "HomeView.swift:98",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Geld, das nur herumliegt, verliert an Kraft. Schütze es durch Sparen (Zinsen) oder Geldanlage!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Money left alone loses power. Protect it with savings (interest) or investing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Money left alone loses power. Protect it with savings (interest) or investing!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Si dejas el dinero quieto, pierde fuerza. ¡Protégelo con ahorro (intereses) o inversión!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 お金をそのままにしておくと力が弱まります。貯金（利子）や投資で守りましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 돈을 그냥 두면 힘이 줄어요. 저축(이자)이나 투자로 지켜 보세요!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 钱放着不动，购买力就会下降。用储蓄（利息）或投资来守住它吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 錢放著不動，購買力就會下降。用儲蓄（利息）或投資來守住它吧！"
          }
        }
      }
    },
    "💡 메시지, 카카오톡 등으로 초대장을 보낼 수 있어요.\n같은 iCloud 계정으로 로그인한 기기라면 데이터가 자동으로 함께 보여요." : {
      "comment" : "InviteView.swift:95",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Du kannst die Einladung per Nachricht oder Chat-App senden.\nAuf Geräten mit derselben iCloud-Anmeldung erscheinen die Daten automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 You can send the invitation by message or any chat app.\nOn devices signed in to the same iCloud account, the data shows up automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 You can send the invitation by message or any chat app.\nOn devices signed in to the same iCloud account, the data shows up automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Puedes enviar la invitación por mensaje o por cualquier app de chat.\nSi el dispositivo usa la misma cuenta de iCloud, los datos aparecen automáticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 メッセージなどで招待状を送れます。\n同じiCloudアカウントでログインした端末なら、データは自動で共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 메시지, 카카오톡 등으로 초대장을 보낼 수 있어요.\n같은 iCloud 계정으로 로그인한 기기라면 데이터가 자동으로 함께 보여요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 可以通过信息等方式发送邀请函。\n用同一个iCloud账户登录的设备，数据会自动同步显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 可以透過訊息等方式傳送邀請函。\n用同一個iCloud帳戶登入的裝置，資料會自動同步顯示。"
          }
        }
      }
    },
    "💡 시세는 하루에 한 번 바뀌어요. 값이 쌀 때 사서 비쌀 때 팔면 이익, 반대면 손해예요!" : {
      "comment" : "InvestView.swift:111",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Die Kurse ändern sich einmal am Tag. Günstig kaufen und teuer verkaufen bringt Gewinn, umgekehrt Verlust!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Prices change once a day. Buy low and sell high to make a profit – the other way round is a loss!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Prices change once a day. Buy low and sell high to make a profit – the other way round is a loss!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Los precios cambian una vez al día. Si compras barato y vendes caro, ganas; si es al revés, pierdes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 値段は1日1回変わります。安いときに買って高いときに売ると得、反対だと損です！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 시세는 하루에 한 번 바뀌어요. 값이 쌀 때 사서 비쌀 때 팔면 이익, 반대면 손해예요!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 价格每天变动一次。低价买入、高价卖出就赚，反过来就亏！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
