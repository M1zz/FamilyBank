        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procedete passo dopo passo con vostro figlio a partire dal passo 1. Ogni passo segue l’ordine «spiegare → chiedere → provare insieme» e bastano 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
