    "💡 돈을 그냥 두면 힘이 줄어요. 저축(이자)이나 투자로 지켜 보세요!" : {
      "comment" : "HomeView.swift:98",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Peníze, které jen leží, ztrácejí sílu. Chraňte je spořením (úroky) nebo investováním!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Geld, das nur herumliegt, verliert an Kraft. Schütze es durch Sparen (Zinsen) oder Geldanlage!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Money left alone loses power. Protect it with savings (interest) or investing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Money left alone loses power. Protect it with savings (interest) or investing!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Si dejas el dinero quieto, pierde fuerza. ¡Protégelo con ahorro (intereses) o inversión!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 L’argent laissé de côté perd de sa force. Protège-le avec l’épargne (intérêts) ou les placements !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 I soldi lasciati fermi perdono forza. Proteggili con il risparmio (interessi) o con gli investimenti!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 お金をそのままにしておくと力が弱まります。貯金（利子）や投資で守りましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 돈을 그냥 두면 힘이 줄어요. 저축(이자)이나 투자로 지켜 보세요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Dinheiro parado perde força. Proteja-o com poupança (juros) ou investimento!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Деньги, которые просто лежат, теряют силу. Защитите их накоплениями (проценты) или вложениями!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 ถ้าวางเงินไว้เฉยๆ พลังจะลดลง รักษาไว้ด้วยการออม (ดอกเบี้ย) หรือการลงทุน!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Để tiền nằm yên thì sức mạnh sẽ giảm. Hãy bảo vệ bằng tiết kiệm (lãi) hoặc đầu tư!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 钱放着不动，购买力就会下降。用储蓄（利息）或投资来守住它吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 錢放著不動，購買力就會下降。用儲蓄（利息）或投資來守住它吧！"
          }
        }
      }
    },
    "💡 메시지, 카카오톡 등으로 초대장을 보낼 수 있어요.\n같은 iCloud 계정으로 로그인한 기기라면 데이터가 자동으로 함께 보여요." : {
      "comment" : "InviteView.swift:95",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Pozvánku můžete poslat zprávou nebo v chatovací aplikaci.\nNa zařízeních přihlášených ke stejnému účtu iCloud se data zobrazí automaticky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Du kannst die Einladung per Nachricht oder Chat-App senden.\nAuf Geräten mit derselben iCloud-Anmeldung erscheinen die Daten automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 You can send the invitation by message or any chat app.\nOn devices signed in to the same iCloud account, the data shows up automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 You can send the invitation by message or any chat app.\nOn devices signed in to the same iCloud account, the data shows up automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Puedes enviar la invitación por mensaje o por cualquier app de chat.\nSi el dispositivo usa la misma cuenta de iCloud, los datos aparecen automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Tu peux envoyer l’invitation par message ou par une appli de discussion.\nSur les appareils connectés au même compte iCloud, les données s’affichent automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Puoi inviare l’invito con un messaggio o un’app di chat.\nSui dispositivi con lo stesso account iCloud i dati compaiono in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 メッセージなどで招待状を送れます。\n同じiCloudアカウントでログインした端末なら、データは自動で共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 메시지, 카카오톡 등으로 초대장을 보낼 수 있어요.\n같은 iCloud 계정으로 로그인한 기기라면 데이터가 자동으로 함께 보여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Você pode enviar o convite por mensagem ou por um app de bate-papo.\nEm aparelhos com a mesma conta do iCloud, os dados aparecem automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Приглашение можно отправить сообщением или через мессенджер.\nНа устройствах с той же учётной записью iCloud данные появятся автоматически."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 ส่งคำเชิญทางข้อความหรือแอปแชตได้\nเครื่องที่ล็อกอิน iCloud บัญชีเดียวกันจะเห็นข้อมูลอัตโนมัติ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Có thể gửi lời mời qua tin nhắn hoặc ứng dụng trò chuyện.\nTrên các thiết bị đăng nhập cùng tài khoản iCloud, dữ liệu sẽ tự động hiện ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 可以通过信息等方式发送邀请函。\n用同一个iCloud账户登录的设备，数据会自动同步显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 可以透過訊息等方式傳送邀請函。\n用同一個iCloud帳戶登入的裝置，資料會自動同步顯示。"
          }
        }
      }
    },
    "💡 시세는 하루에 한 번 바뀌어요. 값이 쌀 때 사서 비쌀 때 팔면 이익, 반대면 손해예요!" : {
      "comment" : "InvestView.swift:111",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Ceny se mění jednou denně. Koupit levně a prodat draho je zisk, opačně ztráta!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Die Kurse ändern sich einmal am Tag. Günstig kaufen und teuer verkaufen bringt Gewinn, umgekehrt Verlust!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Prices change once a day. Buy low and sell high to make a profit – the other way round is a loss!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Prices change once a day. Buy low and sell high to make a profit – the other way round is a loss!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Los precios cambian una vez al día. Si compras barato y vendes caro, ganas; si es al revés, pierdes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Les cours changent une fois par jour. Acheter bas et vendre haut rapporte, l’inverse fait perdre !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 I prezzi cambiano una volta al giorno. Comprare a poco e vendere a tanto fa guadagnare, il contrario fa perdere!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 値段は1日1回変わります。安いときに買って高いときに売ると得、反対だと損です！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 시세는 하루에 한 번 바뀌어요. 값이 쌀 때 사서 비쌀 때 팔면 이익, 반대면 손해예요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Os preços mudam uma vez por dia. Comprar barato e vender caro dá lucro; o contrário dá prejuízo!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
