    "용돈을 받거나 물건을 샀을 때 가볍게 떨려서 알려 줘요." : {
      "comment" : "Roadmap item detail: haptic feedback",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein leichtes Vibrieren meldet dir, wenn Taschengeld eintrifft oder etwas gekauft wird."
          }
        },
        "en" : {
          "stringUnit" : {
