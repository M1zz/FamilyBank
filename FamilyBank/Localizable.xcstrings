    "희소하고 모두가 믿어야 돈이 돼요." : {
      "comment" : "EducationView.swift:51",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penězi je to, čeho je málo a čemu všichni věří."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geld muss knapp sein, und alle müssen ihm vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Money has to be scarce, and everyone has to trust it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Money has to be scarce, and everyone has to trust it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ser dinero hay que ser escaso y que todos confíen en ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour être de l’argent, il faut être rare et que tout le monde y fasse confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per essere denaro bisogna essere rari e tutti devono fidarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数が限られていて、みんなが信じるからお金になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "희소하고 모두가 믿어야 돈이 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ser dinheiro, é preciso ser escasso e todo mundo precisa confiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деньгами становится то, что редко встречается и чему все доверяют."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องหายากและทุกคนเชื่อถือ จึงจะเป็นเงินได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phải khan hiếm và được mọi người tin tưởng thì mới thành tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稀少而且大家都信任，才能成为钱。"
